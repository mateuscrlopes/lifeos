# ===================================================================
# MODELO DE CONFIGURACAO DO LIFEOS
# ===================================================================
# Copie este arquivo para um novo arquivo chamado ".env" (sem .example)
# e preencha os valores reais. O arquivo .env NUNCA vai para o Git.
#
# No Windows (PowerShell), para copiar:
#   Copy-Item .env.example .env
# ===================================================================

# Porta em que o backend roda localmente
PORT=3000

# URL base do projeto Supabase (SEM /rest/v1 no final)
# Ex.: https://xxxxx.supabase.co
SUPABASE_URL=

# Chave publica (anon) do Supabase - pode ficar aqui
SUPABASE_ANON_KEY=
