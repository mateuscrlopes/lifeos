# ===================================================================
# MODELO DE CONFIGURACAO DO LIFEOS
# Copie para .env e preencha. O .env NUNCA vai para o Git.
# ===================================================================

PORT=3000
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Chave de servico do Supabase (service_role).
# Usada APENAS pelo backend para os Atalhos do iOS.
# Encontre em: Supabase > Project Settings > API > service_role key
# NUNCA compartilhe nem coloque no frontend.
SUPABASE_SERVICE_KEY=
